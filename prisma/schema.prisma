generator client {
  provider = "prisma-client-js"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Noticia {
  id               Int      @id @default(autoincrement())
  titulo           String
  resumo           String
  conteudoCompleto String   @db.Text
  dataPublicacao   DateTime
  fonte            String
  urlImagem        String?
  urlNoticia       String   @unique

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("noticias")
}

model CorrenteFilosofica {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  slug      String  @unique
  descricao String? @db.Text

  filosofos Filosofo[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("correntes_filosoficas")
}

model Filosofo {
  id        Int     @id @default(autoincrement())
  nome      String  @unique
  slug      String  @unique
  biografia String? @db.Text

  dataNascimento  DateTime?
  dataFalecimento DateTime?

  imagem String?

  correnteId Int?
  corrente   CorrenteFilosofica? @relation(fields: [correnteId], references: [id])

  obras Obra[]

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@index([correnteId])
  @@map("filosofos")
}

model Obra {
  id             Int       @id @default(autoincrement())
  titulo         String
  resumo         String
  tipo           String
  dataPublicacao DateTime?
  dataComposicao DateTime?
  urlImagem      String?

  filosofoId Int
  filosofo   Filosofo @relation(fields: [filosofoId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("obras")
}

model Video {
  id     Int     @id @default(autoincrement())
  titulo String
  url    String
  banner String?

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@map("videos")
}
